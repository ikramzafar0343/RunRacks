{
  "name": "runracks-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/generate-dotted-map.mjs && node scripts/optimize-assets.mjs",
    "generate:map": "node scripts/generate-dotted-map.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check:lines": "node scripts/check-lines.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "test": "node scripts/test-seams.mjs",
    "test:smoke": "node scripts/smoke-api.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run check:lines && npm run check:boundaries && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^14.5.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotted-map": "^3.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "ttf2woff2": "^8.0.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "onnxruntime-node@1.17.3": true,
    "sharp@0.32.6": true,
    "sharp@0.35.5": true
  }
}
