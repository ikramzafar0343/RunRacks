# Copy to .env.local for local overrides (never commit real secrets).
#
# NEXT_PUBLIC_* = may be bundled into the browser — public only.
# Other keys = server-only; read via src/shared/config/env.ts

# Shown as the app name (safe to expose).
NEXT_PUBLIC_APP_NAME=RunRacks

# Canonical site origin for sitemap, robots, and Open Graph (no trailing slash).
# NEXT_PUBLIC_SITE_URL=https://runracks.com

# Backend Fastify base URL (no trailing slash). WHMCS secrets live only on Backend.
# Until Backend /ready passes a live probe, GET /api/v1/ready returns HTTP 503.
# BACKEND_API_BASE_URL=http://127.0.0.1:4000

# Optional: Frontend-side DATABASE_URL is unused for WHMCS SoR; Postgres is Backend-owned.
# DATABASE_URL=

# Dual-read catalog from Backend cache when "1" (demo Frontend catalog remains until parity).
# BACKEND_CATALOG_ENABLED=0

# AI Advisor: Backend owned agent (AI_PROVIDER=owned, no API keys).
# Frontend proxies /api/v1/ai/* when Backend GET /v1/ai/config is enabled.
# Requires BACKEND_API_BASE_URL pointing at the Backend process.
