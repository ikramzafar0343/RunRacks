{
  "name": "runracks-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "lint": "eslint src scripts --max-warnings 0",
    "check:lines": "node scripts/check-lines.mjs",
    "test": "tsx --test src/platform/__tests__/**/*.test.ts src/features/ai/__tests__/**/*.test.ts",
    "test:replica": "node scripts/check-replica.mjs",
    "test:platform": "tsx --test src/platform/__tests__/**/*.test.ts",
    "test:advisor": "tsx --test src/features/ai/__tests__/advisor.corpus.test.ts src/features/ai/__tests__/advisor.pack.test.ts src/features/ai/__tests__/advisor.plans.test.ts src/features/ai/__tests__/advisor.phrases.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "fastify": "^5.2.1",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  }
}
