# Server
HOST=0.0.0.0
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false

# Session HMAC (min 32 chars). Not JWT. Never commit real secrets.
SESSION_HMAC_SECRET=replace-with-32-plus-char-secret-value
# Optional previous secret during rotation (verify only).
# SESSION_HMAC_SECRET_PREVIOUS=

# PostgreSQL (app role — least privilege). Primary only for the app.
DATABASE_URL=postgres://runracks_app:runracks_app@127.0.0.1:5432/runracks
# Replica smoke (optional): postgresql://runracks_admin:runracks_admin_dev@127.0.0.1:5433/runracks
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000

# Observability — unset means disabled / NOT_CONFIGURED, not fake success.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# ALERT_WEBHOOK_URL=

# WHMCS API (server-only). Missing → NOT_CONFIGURED on live catalog/auth/billing.
# WHMCS_API_URL=https://billing.example.com/includes/api.php
# WHMCS_API_IDENTIFIER=
# WHMCS_API_SECRET=
WHMCS_TIMEOUT_MS=8000

# AI Advisor — owned in-process agent (default). No third-party API keys.
# AI_PROVIDER=owned
# AI_PROVIDER=disabled
AI_MAX_INPUT_CHARS=4000
